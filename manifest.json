          ],
          "description": "输入驱动模式：Default（全局硬件优先，未连降级系统）、System（强制系统底层模拟）、KMBox（强制硬件盒子，未连则报错）"
        }
      ],
      "output_type": "boolean",
      "output_variables": [
        {
          "name": "last_input_status",
          "type": "boolean",
          "description": "鼠标拖拽滑动动作是否成功完成 (true/false)"
        }
      ]
    },
    {
      "tag": "GetKeyState",
      "display_name": "获取按键状态 (GetKeyState)",
      "icon": "🔍",
      "platforms": "All",
      "description": "检测 CapsLock / NumLock 开关锁定状态，或检测修饰键与按键是否正被物理按下",
      "keywords": [
        "keyboard",
        "key",
        "state",
        "capslock",
        "numlock",
        "按键状态",
        "大小写锁定"
      ],
      "fields": [
        {
          "name": "key",
          "display_name": "检测按键 (key)",
          "intrinsic_type": "Enum",
          "required": true,
          "group": "目标按键",
          "default_type": "string",
          "default_value": "CapsLock",
          "presets": [
            "CapsLock",
            "NumLock",
            "ScrollLock",
            "Ctrl",
            "Shift",
            "Alt",
            "Win",
            "Space",
            "Escape",
            "Enter"
          ],
          "description": "待检测的按键名称"
        },
        {
          "name": "check_type",
          "display_name": "检测类型 (check_type)",
          "intrinsic_type": "Enum",
          "required": true,
          "group": "目标按键",
          "default_type": "string",
          "default_value": "ToggleState",
          "presets": [
            "ToggleState",
            "Pressed"
          ],
          "description": "检测类型：ToggleState (锁定开关状态，用于CapsLock等)；Pressed (物理按压状态，用于Ctrl等)"
