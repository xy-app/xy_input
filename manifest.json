          "display_name": "驱动模式 (driver)",
          "intrinsic_type": "Enum",
          "group": "输入驱动",
          "is_advanced": true,
          "default_type": "driver",
          "default_value": "Default",
          "presets": [
            "Default",
            "System",
            "KMBox"
          ],
          "description": "输入驱动模式"
        }
      ],
      "output_type": "string",
      "output_variables": [
