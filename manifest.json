{
  "plugin_id": "xy_input",
  "name": "鼠标与键盘操作 (Mouse & Keyboard)",
  "version": "0.53.0",
  "group": "Input",
  "group_icon": "⌨",
  "description": "提供平滑拟人化鼠标移动、点击、拖拽滑动、滚轮滚动、键盘输入打字、快捷键触发与按键监听功能",
  "actions": [
    {
      "tag": "CellsClick",
      "display_name": "单元格点击 (CellsClick)",
      "icon": "🖲️",
      "platforms": "All",
      "description": "在指定的网格或单元格坐标区域自动执行鼠标点击",
      "keywords": [
        "mouse",
        "click",
        "cells",
        "单元格点击"
      ],
      "fields": [
        {
          "name": "target",
          "display_name": "目标网格区域",
          "intrinsic_type": "Rect",
          "required": true,
          "group": "区域与网格",
          "default_type": "Rect",
          "default_value": "0, 0, 0, 0",
          "presets": [
            "0, 0, 1920, 1080",
            "100, 100, 800, 600"
          ],
          "description": "目标屏幕网格矩形区域 (x, y, width, height)"
        },
        {
          "name": "grid",
          "display_name": "网格行列数",
          "intrinsic_type": "Size",
          "required": true,
          "group": "区域与网格",
          "default_type": "Size",
          "default_value": "3, 3",
          "presets": [
            "3, 3",
            "4, 6",
            "12, 12"
          ],
          "description": "划分网格的列数与行数 (如 3, 3)"
        },
        {
          "name": "delay",
          "display_name": "点击间隔延时 (秒)",
          "intrinsic_type": "real",
          "group": "点击动作",
          "default_type": "real",
          "default_value": "0.05",
          "presets": [
            "0.05",
            "0.1",
            "0.2"
          ],
          "description": "依次点击每个单元格之间的间隔延迟时间 (秒)"
        },
        {
          "name": "button",
          "display_name": "鼠标按键",
          "intrinsic_type": "Enum",
          "group": "点击动作",
          "default_type": "MouseButton",
          "default_value": "Left",
          "presets": [
            "Left",
            "Right",
            "Middle"
          ],
          "description": "触发点击的鼠标键位"
        },
        {
          "name": "driver",
          "display_name": "驱动选择",
          "intrinsic_type": "Enum",
          "group": "输入驱动",
          "is_advanced": true,
          "default_type": "driver",
          "default_value": "Default",
          "presets": [
            "Default",
            "System",
            "KMBox"
          ],
          "description": "输入驱动模式：Default（全局硬件优先，未连降级系统）、System（强制系统底层模拟）、KMBox（强制硬件盒子，未连则报错）"
        }
      ],
      "output_type": "boolean",
      "output_variables": [
        {
          "name": "last_input_status",
          "type": "boolean",
          "description": "单元格批量点击是否全部成功执行 (true/false)"
        }
      ]
    },
    {
      "tag": "Click",
      "display_name": "鼠标点击 (Click)",
      "icon": "🖱️",
      "platforms": "All",
      "description": "在当前鼠标所在位置或屏幕指定坐标上单击或双击鼠标",
      "keywords": [
        "mouse",
        "click",
        "left",
        "right",
        "鼠标点击"
      ],
      "fields": [
        {
          "name": "button",
          "display_name": "鼠标按键",
          "intrinsic_type": "Enum",
          "required": true,
          "group": "点击配置",
          "default_type": "MouseButton",
          "default_value": "Left",
          "presets": [
            "Left",
            "Right",
            "Middle"
          ],
          "description": "触发的鼠标键位"
        },
        {
          "name": "times",
          "display_name": "点击次数",
          "intrinsic_type": "Integer",
          "required": true,
          "group": "点击配置",
          "default_type": "number",
          "default_value": "1",
          "presets": [
            "1",
            "2"
          ],
          "description": "连续点击次数"
        },
        {
          "name": "interval",
          "display_name": "点击间隔秒 (interval)",
          "intrinsic_type": "Real",
          "group": "点击配置",
          "default_type": "real",
          "default_value": "0.05",
          "presets": [
            "0.05",
            "0.1",
            "0.2"
          ],
          "description": "连续点击间的间隔时间 (秒)"
        },
        {
          "name": "modifiers",
          "display_name": "辅助修饰键 (modifiers)",
          "intrinsic_type": "KeySequence",
          "group": "修饰键",
          "default_type": "KeySequence",
          "default_value": "",
          "presets": [
            "",
            "Ctrl",
            "Shift",
            "Alt",
            "Ctrl+Shift"
          ],
          "description": "点击过程中同时按住的修饰键 (如 Ctrl, Shift)"
        },
        {
          "name": "driver",
          "display_name": "驱动选择",
          "intrinsic_type": "Enum",
          "group": "输入驱动",
          "is_advanced": true,
          "default_type": "driver",
          "default_value": "Default",
          "presets": [
            "Default",
            "System",
            "KMBox"
          ],
          "description": "输入驱动模式：Default（全局硬件优先，未连降级系统）、System（强制系统底层模拟）、KMBox（强制硬件盒子，未连则报错）"
        }
      ],
      "output_type": "boolean",
      "output_variables": [
        {
          "name": "last_input_status",
          "type": "boolean",
          "description": "鼠标点击动作是否成功触发 (true/false)"
        }
      ]
    },
    {
      "tag": "ConnectKmbox",
      "display_name": "连接硬件外设盒子 (ConnectKmbox)",
      "icon": "🔌",
      "platforms": "All",
      "description": "连接 KMBox (B+串口 / Net网络) 或 Makcu (ESP32-S3串口) 硬件级键鼠模拟外设，提供原生物理级按键与鼠标模拟，保障设备兼容性；连接成功后 xy_input 中所有点击、移动、按键动作将自动通过物理硬件发送；支持置空或断开以切回系统模拟。",
      "keywords": [
        "KMBox",
        "kmbox",
        "Makcu",
        "makcu",
        "ESP32",
        "硬件盒子",
        "物理外设",
        "硬件模拟",
        "B+",
        "Net"
      ],
      "fields": [
        {
          "name": "device_type",
          "display_name": "设备类型",
          "intrinsic_type": "Enum",
          "required": true,
          "group": "设备与端点",
          "default_type": "string",
          "default_value": "Serial",
          "presets": [
            "Serial",
            "Net",
            "Makcu"
          ],
          "description": "连接类型：Serial 为 KMBox B/B+ 串口模式，Net 为 KMBox Net 网络模式，Makcu 为 Makcu ESP32-S3 串口模式"
        },
        {
          "name": "port_name",
          "display_name": "串口名称",
          "intrinsic_type": "Enum",
          "group": "设备与端点",
          "visible_if": {
            "field": "device_type",
            "one_of": ["Serial", "Makcu"]
          },
          "default_type": "string",
          "default_value": "COM3",
          "presets": [
            "COM3",
            "COM4",
            "COM5",
            "/dev/ttyUSB0"
          ],
          "description": "KMBox B/B+ 或 Makcu 串口通信端口"
        },
        {
          "name": "baud_rate",
          "display_name": "波特率",
          "intrinsic_type": "Integer",
          "group": "设备与端点",
          "visible_if": {
            "field": "device_type",
            "one_of": ["Serial", "Makcu"]
          },
          "default_type": "number",
          "default_value": "115200",
          "presets": [
            "115200",
            "4000000",
            "9600"
          ],
          "description": "串口波特率，KMBox 默认 115200，Makcu 支持 115200 与 4000000 (4M)"
        },
        {
          "name": "remote_addr",
          "display_name": "网络地址",
          "intrinsic_type": "Enum",
          "group": "网络模式",
          "visible_if": {
            "field": "device_type",
            "one_of": ["Net"]
          },
          "default_type": "string",
          "default_value": "192.168.2.188:1234",
          "presets": [
            "192.168.2.188:1234"
          ],
          "description": "KMBox Net 远程 IP 和端口"
        },
        {
          "name": "mac",
          "display_name": "UUID / MAC",
          "intrinsic_type": "Enum",
          "group": "网络模式",
          "visible_if": {
            "field": "device_type",
            "one_of": ["Net"]
          },
          "default_type": "string",
          "default_value": "12345678",
          "presets": [
            "12345678"
          ],
          "description": "KMBox Net 通信校验 MAC (8位十六进制)"
        },
        {
          "name": "disconnect",
          "display_name": "断开切回系统",
          "intrinsic_type": "Boolean",
          "group": "连接控制",
          "default_type": "boolean",
          "default_value": "false",
          "presets": [
            "false",
            "true"
          ],
          "description": "false 表示连接/启用硬件盒子，true 表示断开并切回系统软件模拟"
        },
        {
          "name": "auto_reconnect",
          "display_name": "自动重连 (auto_reconnect)",
          "intrinsic_type": "Boolean",
          "group": "高级重连",
          "is_advanced": true,
          "default_type": "boolean",
          "default_value": "true",
          "presets": [
            "true",
            "false"
          ],
          "description": "通信断开或丢包时是否自动尝试重连"
        },
        {
          "name": "timeout_ms",
          "display_name": "超时毫秒数 (timeout_ms)",
          "intrinsic_type": "Integer",
          "group": "高级重连",
          "is_advanced": true,
          "default_type": "number",
          "default_value": "1000",
          "presets": [
            "500",
            "1000",
            "2000",
            "3000"
          ],
          "description": "硬件握手与通信超时耗时 (毫秒)"
        }
      ],
      "output_type": "void",
      "output_variables": [
        {
          "name": "last_input_status",
          "type": "boolean",
          "description": "硬件外设盒子是否建立连接 (true/false)"
        }
      ]
    },
    {
